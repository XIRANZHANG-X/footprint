// Cloudflare Workers 部署配置（决策 0007）。
// 一个 Worker 同时提供前端静态文件（dist/）和 /api/* 代理。
// 密钥不写在这里：DASHSCOPE_API_KEY 和 ACCESS_TOKEN 用 `wrangler secret put` 设置。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "footprint-journal",
  "main": "server/worker.ts",
  "compatibility_date": "2026-11-01",
  // 使用免费的 *.workers.dev 网址；不开每个版本单独的预览网址，对外只有一个入口
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // 单页应用：找不到的路径都返回 index.html
    "not_found_handling": "single-page-application",
    // 否则 /api/* 也会被当成"找不到的页面"返回 index.html
    "run_worker_first": ["/api/*", "/s/*"],
    // 跟着看的页面要由 Worker 转给 share.html（决策 0026）
    "binding": "ASSETS",
  },
  // 跟着看的加密包（决策 0026）。账号没开通 R2，先用 KV
  "kv_namespaces": [
    { "binding": "SHARES", "id": "f809878b9a8e4d70b891a7a035596e18" },
  ],
  "observability": { "enabled": true },
  // 按"IP + 接口"限流（决策 0018 第 3 条），代码在 server/app.ts 的 rateLimit。
  // namespace_id 是自己定的数字，在同一个 Cloudflare 账号里不重复即可；period 只能是 10 或 60 秒
  "ratelimits": [
    // 花百炼额度的接口：整理、转写、偏好提炼、出行总结
    {
      "name": "AI_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
    // 不花钱的：口令验证、地名（Nominatim 被刷会封我们）
    {
      "name": "LIGHT_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
}
