# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
# 阿里云百炼（DashScope）API key，仅由 server/ 读取，绝不进入前端代码。
DASHSCOPE_API_KEY=
# 代理端口，需与 vite.config.ts 中的 proxy 保持一致。不用通用的 PORT，
# 因为很多工具会给前端设置 PORT，两者会冲突。
API_PORT=8787

# 以下可选，不填就用默认值（见 server/dashscope.ts）
# 旧域名仍可用；也可以换成控制台里带业务空间 ID 的新域名
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ASR_MODEL=qwen3-asr-flash
# VL_MODEL=qwen3-vl-plus
