# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
# 阿里云百炼（DashScope）API key，仅由 server/ 读取，绝不进入前端代码。
DASHSCOPE_API_KEY=
# 代理端口，需与 vite.config.ts 中的 proxy 保持一致。不用通用的 PORT，
# 因为很多工具会给前端设置 PORT，两者会冲突。
API_PORT=8787
# 访问口令（决策 0008）。本机开发可以留空（不要求口令）；填了就和线上一样校验。
# 线上用 `npx wrangler secret put ACCESS_TOKEN` 设置，不写在任何提交的文件里。
ACCESS_TOKEN=

# 以下可选，不填就用默认值（见 server/dashscope.ts）
# 旧域名仍可用；也可以换成控制台里带业务空间 ID 的新域名
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ASR_MODEL=qwen3-asr-flash
# VL_MODEL=qwen3-vl-plus

# 地图底图（可选，前端读取，会进入浏览器代码，不要放密钥）。默认 OpenStreetMap。
# 注意：高德等国内底图使用 GCJ-02 坐标，叠加 GPS（WGS-84）坐标会偏几百米。
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap

# 高德 Web 服务的 key（决策 0021）：国内的地名、地点搜索、行政区边界。不填就全部用 OpenStreetMap
AMAP_WEB_KEY=
